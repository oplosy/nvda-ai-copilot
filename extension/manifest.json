{
  "manifest_version": 3,
  "name": "NVDA AI Copilot",
  "version": "0.5.0",
  "description": "Gives the NVDA AI Copilot coordinator grounded access to page elements.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "context.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "grounding.js",
        "context.js",
        "changes.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "nvda-ai-copilot@oplosy",
      "strict_min_version": "128.0"
    }
  }
}
